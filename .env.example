# Public site URL for Open Graph, sitemap, and robots.
# Production: https://stablemoney.dev (also the build default if unset).
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://stablemoney.dev

# Used by app/api/cron/route.ts, which the Vercel Cron Job (see vercel.json)
# calls daily to trigger a redeploy so market data stays fresh.
# CRON_SECRET: any random string; Vercel sends it automatically as a Bearer
#   token on cron-triggered requests once this env var is set.
# DEPLOY_HOOK_URL: create in Vercel Project Settings > Git > Deploy Hooks.
CRON_SECRET=
DEPLOY_HOOK_URL=
