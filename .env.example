# Public site URL for Open Graph, sitemap, and robots.
# Production: https://stablemoney.dev (also the build default if unset).
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://stablemoney.dev

# Used by app/api/cron/route.ts, which a Coolify Scheduled Task calls daily
# to trigger a redeploy so market data stays fresh (see README > Deploy).
# CRON_SECRET: random string; callers send it as `Authorization: Bearer <secret>`.
# DEPLOY_HOOK_URL: Coolify > Application > Webhooks > Deploy Webhook URL.
# DEPLOY_HOOK_TOKEN: Coolify API token with deploy permission.
CRON_SECRET=
DEPLOY_HOOK_URL=
DEPLOY_HOOK_TOKEN=
